# Copy to .env and fill in. Never commit .env.
# Port 5433 avoids clashing with a Postgres already running on 5432.
SNOMED_DB_HOST=127.0.0.1
SNOMED_DB_PORT=5433
SNOMED_DB_NAME=snomed
SNOMED_DB_USER=snomed
SNOMED_DB_PASSWORD=change-me
# Optional. Schema that holds the SNOMED tables (default: snomed)
SNOMED_DB_SCHEMA=snomed

# Optional: semantic and hybrid search. Without these the API returns 501 for mode=semantic|hybrid.
# See docs/semantic-search-runbook.md.
# Embedding__BaseUrl=http://localhost:11434
# Embedding__Model=nomic-embed-text
# Embedding__QueryPrefix=search_query: 
# Embedding__DocumentPrefix=search_document: 
